# --------------------------------------------------------------------------- #
# VaakDB backend configuration. Copy to .env and fill in.
# Passwords containing @ : / # ? may be written as-is or percent-encoded
# (@ -> %40); the backend encodes them correctly either way.
# --------------------------------------------------------------------------- #

APP_ENV=development              # development | test | production
CORS_ORIGINS=http://localhost:3000

# ---- databases (kept separate) --------------------------------------------- #
# meta_db: users, uploads, operations, audit_logs, query_history (alembic upgrade head)
META_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/meta_db

# target_db: the user's data. RO = vaak_ro (reads), RW = vaak_rw (writes).
# Create both roles with: python scripts/setup_roles.py --admin-url <superuser url>
TARGET_DB_RO_URL=postgresql://vaak_ro:CHANGE_ME@localhost:5432/target_db
TARGET_DB_RW_URL=postgresql://vaak_rw:CHANGE_ME@localhost:5432/target_db
# Development fallback used for both when the two above are not set:
# TARGET_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/target_db

# Every user has a private workspace: their schemas are stored as u<user_id>_<name>.
DEFAULT_SCHEMA=main
MAX_SCHEMAS_PER_USER=25

# ---- limits ----------------------------------------------------------------- #
MAX_INSERT_ROWS=10000
INSERT_BATCH_SIZE=500
MAX_UPLOAD_MB=10
UPLOAD_DIR=./var/uploads
OPERATION_TTL_MINUTES=15
STATEMENT_TIMEOUT_MS=30000
READ_TIMEOUT_MS=5000
CSV_EXPORT_MAX_ROWS=50000

# ---- auth ------------------------------------------------------------------- #
# >= 32 random characters. AI_JWT_SECRET (app/ai) should be the same value.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
AI_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_REGISTRATION=true
# Original app/ai routes (/api/v1/ai/*): not isolated per user, keep off.
ENABLE_AI_ROUTES=false

# ---- LLM -------------------------------------------------------------------- #
LLM_PROVIDER=groq                # groq | gemini (the other is the fallback)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Leave empty for 3.x models (a budget of 0 makes them time out).
GEMINI_THINKING_BUDGET=

# ---- original app/ai module (only used when ENABLE_AI_ROUTES=true) --------- #
# Natural-language SELECT in chat does NOT need these: it runs inside each
# user's workspace through TARGET_DB_RO_URL.
# DATABASE_READ_URL=postgresql://vaak_ro:CHANGE_ME@localhost:5432/target_db
# DATABASE_WRITE_URL=postgresql://vaak_ro:CHANGE_ME@localhost:5432/target_db
